{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Python: test_train",
      "type": "python",
      "request": "launch",
      "program": "${workspaceFolder}/pawa/test_train.py",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "test freeze",
      "type": "python",
      "request": "launch",
      "module": "torch.distributed.run",
      "args": [
        "--nnodes",
        "1",
        "--nproc_per_node",
        "1",
        "--standalone",
        "tests/model/test_freeze.py"
      ],
      "console": "integratedTerminal",
      "env": {
        "WORLD_SIZE": "1"
      },
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "Acc Training Debug",
      "type": "python",
      "request": "launch",
      "module": "accelerate.commands.launch",
      "args": [
        "--config_file",
        "experiments/configs/pt/acc_config_pt.yaml",
        "--main_process_port",
        "29502",
        "--num_processes",
        "1",
        "--num_machines",
        "1",
        "src/train.py",
        "experiments/configs/pt/llamafactory_args_pt.yaml",
        "auto_output_dir=True",
        "auto_output_root=./outputs/debug",
        "max_samples=2000",
        "use_unsloth=True"
      ],
      "console": "integratedTerminal",
      "env": {
        "WANDB_PROJECT": "llamafactory-debug",
        "CUDA_VISIBLE_DEVICES": "0",
        "DISABLE_VERSION_CHECK": "1"
      },
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "Acc Eval Debug",
      "type": "python",
      "request": "launch",
      "module": "accelerate.commands.launch",
      "args": [
        "--num_machines=1",
        "--num_processes=1",
        "--main_process_port",
        "29502",
        "experiments/east_afri_eval.py"
      ],
      "console": "integratedTerminal",
      "env": {
        "WANDB_PROJECT": "llamafactory-debug",
        "CUDA_VISIBLE_DEVICES": "0",
        "DISABLE_VERSION_CHECK": "1"
      },
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "Acc Training Debug SFT",
      "type": "python",
      "request": "launch",
      "module": "accelerate.commands.launch",
      "justMyCode": false,
      "args": [
        "--config_file",
        "experiments/configs/sft/acc_config_sft.yaml",
        "--main_process_port",
        "29503",
        "--num_processes",
        "1",
        "--num_machines",
        "1",
        "src/train.py",
        "experiments/configs/sft/llamafactory_args_sft.yaml",
        "auto_output_dir=True",
        "auto_output_root=./outputs/debug",
        "max_samples=2000",
        "do_train=False"
      ],
      "console": "integratedTerminal",
      "env": {
        "WANDB_PROJECT": "llamafactory-debug",
        "CUDA_VISIBLE_DEVICES": "0",
        "DISABLE_VERSION_CHECK": "1"
      },
      "cwd": "${workspaceFolder}"
    }
  ]
}
